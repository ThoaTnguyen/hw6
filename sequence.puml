@startuml
title School Facility Rental - Sequence Diagram

actor Renter
participant Website
participant "School Staff" as Staff
participant "Payment Service" as Pay
participant "Email Service" as Email

Renter -> Website: choose facility, date, time, and event type
activate Website
Website -> Website: check availability

alt not available
  Website --> Renter: facility not available
else available
  Renter -> Website: submit request (contact information)
  Website -> Website: record request
  Website -> Staff: send request for review
  activate Staff
  Staff -> Staff: review request

  alt approved
    Staff --> Website: approved
    deactivate Staff
    Website -> Pay: charge renter
    activate Pay

    alt payment succeeds
      Pay --> Website: payment succeeded
      deactivate Pay
      Website -> Website: save booking
      Website -> Email: send confirmation email
      activate Email
      Email --> Renter: booking confirmed
      deactivate Email
    else payment fails
      Pay --> Website: payment failed
      deactivate Pay
      Website -> Website: record payment failure
      Website -> Email: send payment-failure email
      activate Email
      Email --> Renter: payment failed
      deactivate Email
    end

  else rejected
    Staff --> Website: rejected
    deactivate Staff
    Website -> Website: record rejection
    Website -> Email: send rejection email
    activate Email
    Email --> Renter: request rejected
    deactivate Email
  end
end

deactivate Website

@enduml
